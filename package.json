{
	"name": "cob-rag-mcp",
	"version": "0.2.0",
	"description": "MCP server and CLI for cob-rag-engine, the self-hosted knowledge layer for AI assistants and agents",
	"mcpName": "io.github.callobuzz/cob-rag-mcp",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.32.1",
	"bin": {
		"cob-rag-mcp": "dist/cli/index.js",
		"cob-rag-engine": "dist/cli/index.js"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"dev": "tsup --watch",
		"build": "tsup",
		"gen:api": "node scripts/gen-api.mjs",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"rag",
		"retrieval-augmented-generation",
		"knowledge-base",
		"ai-agents",
		"cli",
		"self-hosted",
		"cob-rag-engine"
	],
	"author": "COB (https://github.com/callobuzz)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/callobuzz/cob-rag-mcp.git"
	},
	"homepage": "https://callobuzz.github.io/cob-rag-mcp",
	"bugs": {
		"url": "https://github.com/callobuzz/cob-rag-mcp/issues"
	},
	"files": [
		"dist",
		"!dist/**/*.map",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.31.0",
		"commander": "^14.0.3",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^22.20.4",
		"openapi-typescript": "^7.13.0",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
